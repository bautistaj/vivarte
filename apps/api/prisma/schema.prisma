generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  artworks     Artwork[]
  createdAt    DateTime  @default(now())
}

model Artwork {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageKey    String
  videoKey    String
  mindKey     String
  imageWidth  Int
  imageHeight Int
  scanCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
