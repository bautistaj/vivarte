# ─── Base de datos (SQLite) ───────────────────────────────────────────────────
# LOCAL (dev sin Docker): file:./dev.db
# Docker / VPS:          file:/app/data/vivarte.db
DATABASE_URL=file:./dev.db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# ─── Storage ──────────────────────────────────────────────────────────────────
# LOCAL (dev sin Docker): ./uploads  (se crea automáticamente)
# Docker / VPS:           /app/uploads (volumen)
UPLOAD_DIR=./uploads

# ─── URL pública ──────────────────────────────────────────────────────────────
# LOCAL:       http://localhost:3000
# PRODUCCIÓN:  https://bautistaj.dev/vivarte
PUBLIC_BASE_URL=http://localhost:3000

# ─── Límites de archivos ──────────────────────────────────────────────────────
MAX_IMAGE_SIZE=10485760   # 10 MB
MAX_VIDEO_SIZE=52428800   # 50 MB
